#. Translators: Message to report wrong configuration.
#: addon\globalPlugins\pcKbBrl.py:512
msgid "None or all dots should be configured."
msgstr "Se deberían configurar todos o ningún punto."

#. Translators: Title of message dialog.
#. Translators: Title of message box
#: addon\globalPlugins\pcKbBrl.py:514 addon\globalPlugins\pcKbBrl.py:535
#: addon\globalPlugins\pcKbBrl.py:546
msgid "Error"
msgstr "Error"

#. Translators: Message to report wrong configuration.
#: addon\globalPlugins\pcKbBrl.py:533
msgid "Configured keys for pcKbBrl shouldn't be repeated."
msgstr "No deberían repetirse las teclas configuradas para PCKBBRL."

#. Translators: Message to report wrong configuration.
#: addon\globalPlugins\pcKbBrl.py:544
msgid "Set at least a confirm key if timeout for one hand mode is 0."
msgstr "Configura al menos una tecla de confirmación si el tiempo de espera del modo de una mano es 0."

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "PC Keyboard Braille Input"
msgstr "Entrada Braille a través del teclado del PC"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Allows braille to be entered via the PC keyboard."
msgstr "Permite introducir Braille mediante el teclado del PC."

