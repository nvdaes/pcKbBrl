#. Translators: Describes a command.
#: addon\globalPlugins\pcKbBrl.py:378
msgid "Toggles braille input from the PC keyboard."
msgstr "ورودیِ بریل را از صفحه‌کلیدِ رایانه فعال یا غیر فعال میکند."

#. Translators: Reported when braille input from the PC keyboard is disabled.
#: addon\globalPlugins\pcKbBrl.py:385
msgid "Braille input from PC keyboard disabled"
msgstr "ورودیِ بریل از صفحه‌کلیدِ رایانه غیرفعال شد"

#. Translators: Reported when braille input from the PC keyboard is enabled.
#: addon\globalPlugins\pcKbBrl.py:389
msgid "Braille input from PC keyboard enabled"
msgstr "ورودیِ بریل از صفحه‌کلیدِ رایانه فعال شد"

#. Translators: Describes a command.
#: addon\globalPlugins\pcKbBrl.py:397
#, python-brace-format
msgid "Shows the {summary} settings."
msgstr ""

#. Translators: label of a dialog.
#: addon\globalPlugins\pcKbBrl.py:410
msgid "&Type using one hand"
msgstr "&تایپ کردن با یک دست"

