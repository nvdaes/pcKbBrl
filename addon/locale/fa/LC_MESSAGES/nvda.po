#: addon\globalPlugins\pcKbBrl.py:512
msgid "None or all dots should be configured."
msgstr "هیچیک یا همه‌ی نقطه‌ها باید پیکربندی شوند."

#. Translators: Title of message dialog.
#. Translators: Title of message box
#: addon\globalPlugins\pcKbBrl.py:514 addon\globalPlugins\pcKbBrl.py:535
#: addon\globalPlugins\pcKbBrl.py:546
msgid "Error"
msgstr "خطا"

#. Translators: Message to report wrong configuration.
#: addon\globalPlugins\pcKbBrl.py:533
msgid "Configured keys for pcKbBrl shouldn't be repeated."
msgstr "کلیدهای پیکربندی‌شده برای افزونه نباید تکراری باشند."

#. Translators: Message to report wrong configuration.
#: addon\globalPlugins\pcKbBrl.py:544
msgid "Set at least a confirm key if timeout for one hand mode is 0."
msgstr "چنانچه مدت زمان برای حالتِ یکدستی صفر است، دستکم یک کلید تایید برای آن تعیین کنید."

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
